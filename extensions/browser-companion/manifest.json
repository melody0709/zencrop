{
  "manifest_version": 3,
  "name": "ZenCrop Browser Companion",
  "description": "Provides webpage element rectangles to ZenCrop while selecting a screenshot. Requires access to sites for the desktop shortcut.",
  "version": "1.0.4",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "permissions": ["nativeMessaging", "webNavigation", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "worker.js"},
  "action": {
    "default_title": "Reconnect ZenCrop webpage selection",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "all_frames": true,
    "match_origin_as_fallback": true,
    "run_at": "document_start",
    "world": "ISOLATED"
  }]
}

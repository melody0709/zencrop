    LTEXT         "VLM Max Tokens:", IDC_DOC_MAX_TOKENS_LABEL, 10, 194, 80, 9
    COMBOBOX      IDC_DOC_MAX_TOKENS, 94, 192, 172, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    DEFPUSHBUTTON "OK", IDOK, 174, 222, 44, 13
    PUSHBUTTON    "Cancel", IDCANCEL, 224, 222, 44, 13
END

IDD_OCR_PPOCRV6_OPTIONS DIALOGEX 0, 0, 276, 195
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PP-OCRv6 Options"
FONT 9, "Segoe UI"
BEGIN
    LTEXT         "Preset:", IDC_PPOCRV6_PRESET_LABEL, 10, 10, 34, 9
    COMBOBOX      IDC_PPOCRV6_PRESET, 46, 8, 164, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON    "Apply", IDC_PPOCRV6_PRESET_APPLY, 214, 8, 52, 13

    LTEXT         "Detection and Recognition Parameters:", IDC_PPOCRV6_ADV_LABEL, 10, 26, 256, 9

    LTEXT         "Side (px):", IDC_PPOCRV6_LIMIT_SIDE_LABEL, 10, 42, 58, 9
    EDITTEXT      IDC_PPOCRV6_LIMIT_SIDE, 70, 40, 42, 11, ES_NUMBER
    LTEXT         "Type:", IDC_PPOCRV6_LIMIT_TYPE_LABEL, 126, 42, 44, 9
    COMBOBOX      IDC_PPOCRV6_LIMIT_TYPE, 172, 40, 94, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT         "Pixel thresh %:", IDC_PPOCRV6_DET_THRESH_LABEL, 10, 58, 58, 9
    EDITTEXT      IDC_PPOCRV6_DET_THRESH, 70, 56, 42, 11, ES_NUMBER
    LTEXT         "Box conf %:", IDC_PPOCRV6_BOX_THRESH_LABEL, 126, 58, 52, 9
    EDITTEXT      IDC_PPOCRV6_BOX_THRESH, 180, 56, 42, 11, ES_NUMBER

    LTEXT         "Crop expand %:", IDC_PPOCRV6_UNCLIP_LABEL, 10, 74, 58, 9
    EDITTEXT      IDC_PPOCRV6_UNCLIP, 70, 72, 42, 11, ES_NUMBER
    LTEXT         "Min text score %:", IDC_PPOCRV6_REC_SCORE_LABEL, 126, 74, 60, 9
    EDITTEXT      IDC_PPOCRV6_REC_SCORE, 188, 72, 42, 11, ES_NUMBER

    LTEXT         "Rec batch:", IDC_PPOCRV6_REC_BATCH_LABEL, 10, 90, 58, 9

IDD_SETTINGS_TRANSLATE_PROVIDERS DIALOGEX 0, 0, 276, 256
STYLE DS_SHELLFONT | WS_CHILD | WS_VISIBLE | WS_CAPTION
CAPTION "Translation Providers"
FONT 9, "Segoe UI"
BEGIN
    LTEXT         "Provider:", -1, 10, 10, 48, 9
    COMBOBOX      IDC_PROVIDER_PROFILE, 60, 8, 134, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON    "Add", IDC_PROVIDER_ADD, 200, 8, 32, 13
    PUSHBUTTON    "Copy", IDC_PROVIDER_DUPLICATE, 236, 8, 32, 13

    AUTOCHECKBOX  "Enable in Translate", IDC_PROVIDER_ENABLED, 60, 23, 134, 11

    // Name row: the Name edit gives up 30 DLU so the wider button fits. "Reset
    // profile" needs ~50 DLU at 9pt and the rename from "Reset" left its old 32-DLU
    // rect behind, which is why the label was cut in half -- hence wide-then-narrow
    // here. Both buttons end on the columns the rest of the page already uses: 232
    // (Add, Restore defaults) and 268 (Copy, Test connection, every full-width field),
    // with the same 4-DLU gaps, and the edit keeps the 11-DLU single-line height.
    LTEXT         "Name:", -1, 10, 39, 48, 9
    EDITTEXT      IDC_PROVIDER_NAME, 60, 37, 104, 11, ES_AUTOHSCROLL
    PUSHBUTTON    "Reset profile", IDC_PROVIDER_RESET, 168, 37, 64, 13
    PUSHBUTTON    "Delete", IDC_PROVIDER_DELETE, 236, 37, 32, 13

    LTEXT         "Base URL:", -1, 10, 55, 48, 9
    EDITTEXT      IDC_PROVIDER_ENDPOINT, 60, 53, 208, 11, ES_AUTOHSCROLL

    LTEXT         "API protocol:", -1, 10, 71, 48, 9
    COMBOBOX      IDC_PROVIDER_PROTOCOL, 60, 69, 208, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT         "Auth:", -1, 10, 87, 48, 9
    COMBOBOX      IDC_PROVIDER_AUTH_MODE, 60, 85, 134, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT         "Model:", IDC_PROVIDER_MODEL_LABEL, 10, 103, 48, 9
    COMBOBOX      IDC_PROVIDER_MODEL, 60, 101, 134, 90, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON    "Test connection", IDC_PROVIDER_TEST, 200, 101, 68, 13

    LTEXT         "Region:", IDC_PROVIDER_REGION_LABEL, 10, 103, 48, 9
    EDITTEXT      IDC_PROVIDER_REGION, 60, 101, 134, 11, ES_AUTOHSCROLL

    AUTOCHECKBOX  "Custom model", IDC_PROVIDER_CUSTOM_MODEL, 60, 117, 68, 11
    PUSHBUTTON    "Remove", IDC_PROVIDER_REMOVE_MODEL, 134, 116, 36, 12
    // Ended at 220 before: the row's right edge now lands on the same 232 column as
    // Add / Restore defaults / Reset profile.
    PUSHBUTTON    "Models...", IDC_PROVIDER_MANAGE_MODELS, 176, 116, 56, 12

    PUSHBUTTON    "Fetch available models", IDC_PROVIDER_FETCH_MODELS, 60, 131, 100, 13
    PUSHBUTTON    "Restore defaults", IDC_PROVIDER_RESTORE_MODELS, 166, 131, 66, 13

    CONTROL       "", IDC_PROVIDER_TEST_STATUS, "Static", SS_LEFT | SS_NOTIFY, 60, 147, 208, 26

    LTEXT         "Reasoning:", IDC_PROVIDER_REASONING_LABEL, 10, 178, 48, 9
    COMBOBOX      IDC_PROVIDER_REASONING, 60, 176, 76, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT         "Temp:", IDC_PROVIDER_TEMPERATURE_LABEL, 142, 178, 26, 9
    EDITTEXT      IDC_PROVIDER_TEMPERATURE, 170, 176, 24, 11, ES_AUTOHSCROLL

    LTEXT         "API key:", IDC_PROVIDER_KEY_LABEL, 10, 193, 48, 9
    EDITTEXT      IDC_PROVIDER_KEY, 60, 191, 134, 11, ES_PASSWORD | ES_AUTOHSCROLL
    PUSHBUTTON    "Show", IDC_PROVIDER_KEY_ACTION, 200, 191, 32, 13
    PUSHBUTTON    "Clear", IDC_PROVIDER_KEY_CLEAR, 236, 191, 32, 13

    LTEXT         "", IDC_PROVIDER_KEY_STATUS, 60, 206, 208, 9

    LTEXT         "Advanced JSON:", IDC_PROVIDER_ADVANCED_LABEL, 10, 219, 48, 9
    EDITTEXT      IDC_PROVIDER_ADVANCED, 60, 217, 208, 22, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL

    LTEXT         "", IDC_PROVIDER_DATA_ROUTE, 10, 242, 258, 10
END

// Model catalogue picker for one provider profile. Kept as its own dialog rather
// than an embedded list: the list needs search, a source column and a capacity
// warning, and a property-sheet page at this size cannot host all of that without
// squeezing the fields it already has.
IDD_TRANSLATION_MODEL_PICKER DIALOGEX 0, 0, 300, 254
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Models"
FONT 9, "Segoe UI"
BEGIN
    LTEXT         "Search:", -1, 8, 11, 28, 9
    EDITTEXT      IDC_MODEL_PICKER_SEARCH, 38, 9, 254, 12, ES_AUTOHSCROLL
    CONTROL       "", IDC_MODEL_PICKER_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 8, 25, 284, 166
    LTEXT         "", IDC_MODEL_PICKER_HINT, 8, 196, 284, 10
    PUSHBUTTON    "Set active", IDC_MODEL_PICKER_SET_ACTIVE, 8, 211, 52, 14
    EDITTEXT      IDC_MODEL_PICKER_NEW, 64, 212, 96, 12, ES_AUTOHSCROLL
    PUSHBUTTON    "Add", IDC_MODEL_PICKER_ADD, 164, 211, 32, 14
    PUSHBUTTON    "Select all", IDC_MODEL_PICKER_SELECT_ALL, 200, 211, 44, 14
    PUSHBUTTON    "Clear all", IDC_MODEL_PICKER_CLEAR_ALL, 248, 211, 44, 14
    DEFPUSHBUTTON "OK", IDOK, 200, 232, 44, 14
    PUSHBUTTON    "Cancel", IDCANCEL, 248, 232, 44, 14
END


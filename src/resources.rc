    COMBOBOX      IDC_MODEL_DOWNLOAD_MIRROR, 54, 25, 176, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT         "Location:", -1, 10, 44, 42, 9

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ZENCROP_PRODUCT_FILEVERSION
 PRODUCTVERSION ZENCROP_PRODUCT_FILEVERSION
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "melody0709"
            VALUE "FileDescription", "ZenCrop"
            VALUE "FileVersion", ZENCROP_PRODUCT_FILEVERSION_STR
            VALUE "InternalName", "ZenCrop.exe"
            VALUE "LegalCopyright", "Copyright (C) 2024"
            VALUE "OriginalFilename", "ZenCrop.exe"
            VALUE "ProductName", "ZenCrop"
            VALUE "ProductVersion", ZENCROP_PRODUCT_FILEVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END


    PUSHBUTTON    "...", IDC_MODEL_DOWNLOAD_BROWSE, 316, 56, 30, 14

    LTEXT         "", IDC_MODEL_DOWNLOAD_SIZE, 12, 80, 334, 12
    LTEXT         "", IDC_MODEL_DOWNLOAD_INSTALLED, 12, 96, 334, 12
    CONTROL       "", IDC_MODEL_DOWNLOAD_PROGRESS, "msctls_progress32", PBS_SMOOTH, 12, 116, 334, 12
    LTEXT         "Ready", IDC_MODEL_DOWNLOAD_STATUS, 12, 134, 334, 16
    EDITTEXT      IDC_MODEL_DOWNLOAD_DETAILS, 12, 154, 334, 34, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL

    PUSHBUTTON    "Open Folder", IDC_MODEL_DOWNLOAD_OPEN, 12, 198, 72, 18
    PUSHBUTTON    "Cancel Download", IDC_MODEL_DOWNLOAD_CANCEL, 142, 198, 86, 18
    DEFPUSHBUTTON "Download", IDC_MODEL_DOWNLOAD_START, 234, 198, 58, 18
    PUSHBUTTON    "Close", IDCANCEL, 298, 198, 50, 18
END

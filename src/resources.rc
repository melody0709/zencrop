    LTEXT         "Balanced=min/64 native. Quality=min/320 mild upscale. Fast=max/1280 mild downscale. Same model (Variant on main page). Official 3.7=reference.", IDC_PPOCRV6_HINT_LABEL, 10, 108, 256, 32

    DEFPUSHBUTTON "OK", IDOK, 174, 172, 44, 13
    PUSHBUTTON    "Cancel", IDCANCEL, 224, 172, 44, 13
END

IDD_OCR_MODEL_DOWNLOAD DIALOGEX 0, 0, 310, 195
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
